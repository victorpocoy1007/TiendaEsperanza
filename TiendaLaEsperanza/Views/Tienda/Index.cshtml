@{
    ViewData["Title"] = "Tienda";
    ViewData["ActivePage"] = "Tienda";
}

<div class="page-header">
    <h1>🏪 Tienda</h1>
    <p>Venta diaria, salidas y retiros</p>
</div>

<div class="tabs">
    <button type="button" class="tab-btn active" data-tab="venta">Venta</button>
    <button type="button" class="tab-btn" data-tab="salidas">Salidas</button>
    <button type="button" class="tab-btn" data-tab="retiro">Retiro</button>
    <button type="button" class="tab-btn" data-tab="resumen">Resumen</button>
    <button type="button" class="tab-btn" data-tab="historial">Historial</button>
</div>

<!-- Venta del día -->
<div class="tab-panel active" id="panel-venta">
    <div class="card">
        <p class="card-title">Venta del día</p>
        <p class="card-value" id="tiendaVentaHoy">Sin registrar</p>
        <p class="card-sub" id="tiendaVentaHoraInfo"></p>
    </div>
    <div class="card" id="formVentaCard">
        <div class="field">
            <label for="tiendaMontoVenta">Monto de venta</label>
            <input type="number" id="tiendaMontoVenta" min="0.01" step="0.01" placeholder="0.00" />
        </div>
        <button type="button" class="btn btn-primary" id="btnRegistrarVentaTienda">Registrar venta diaria</button>
    </div>
</div>

<!-- Salidas -->
<div class="tab-panel" id="panel-salidas">
    <div class="card">
        <div class="field">
            <label for="tiendaMontoSalida">Monto</label>
            <input type="number" id="tiendaMontoSalida" min="0.01" step="0.01" placeholder="0.00" />
        </div>
        <div class="field">
            <label for="tiendaDescSalida">Descripción (opcional)</label>
            <input type="text" id="tiendaDescSalida" placeholder="Ej. Compra de productos" />
        </div>
        <button type="button" class="btn btn-outline" id="btnAgregarSalidaTienda">Agregar salida</button>
    </div>

    <div class="card">
        <p class="card-title">Total de salidas pendientes</p>
        <p class="card-value negativo" id="tiendaTotalSalidasPendientes">Q 0.00</p>
    </div>

    <div class="card" id="tiendaListaSalidasPendientes">
        <div class="empty-state">No hay salidas pendientes.</div>
    </div>

    <button type="button" class="btn btn-primary" id="btnProcesarSalidasTienda">Registrar salidas del día</button>
</div>

<!-- Retiro -->
<div class="tab-panel" id="panel-retiro">
    <div class="card">
        <div class="field">
            <label for="tiendaMontoRetiro">Monto</label>
            <input type="number" id="tiendaMontoRetiro" min="0.01" step="0.01" placeholder="0.00" />
        </div>
        <div class="field">
            <label for="tiendaDescRetiro">Descripción (opcional)</label>
            <input type="text" id="tiendaDescRetiro" placeholder="Ej. Compra externa" />
        </div>
        <button type="button" class="btn btn-danger" id="btnRetiroTienda">Registrar retiro</button>
    </div>
</div>

<!-- Resumen -->
<div class="tab-panel" id="panel-resumen">
    <div class="grid-2">
        <div class="card">
            <p class="card-title">Ventas de hoy</p>
            <p class="card-value" id="tiendaResVentas">Q 0.00</p>
        </div>
        <div class="card">
            <p class="card-title">Salidas de hoy</p>
            <p class="card-value negativo" id="tiendaResSalidas">Q 0.00</p>
        </div>
        <div class="card">
            <p class="card-title">Retiros de hoy</p>
            <p class="card-value negativo" id="tiendaResRetiros">Q 0.00</p>
        </div>
        <div class="card">
            <p class="card-title">Saldo de préstamos</p>
            <p class="card-value" id="tiendaResPrestamos">Q 0.00</p>
        </div>
    </div>
</div>

<!-- Historial -->
<div class="tab-panel" id="panel-historial">
    <div class="card" id="tiendaHistorial">
        <div class="empty-state">Sin movimientos todavía.</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/area-simple.js" asp-append-version="true"></script>
    <script src="~/js/tienda.js" asp-append-version="true"></script>
}
