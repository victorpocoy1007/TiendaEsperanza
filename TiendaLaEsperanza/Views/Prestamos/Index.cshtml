@{
    ViewData["Title"] = "Préstamos";
    ViewData["ActivePage"] = "Home";
}

<div class="page-header">
    <h1>🤝 Préstamos entre áreas</h1>
    <p>Tienda, Cocos y Hielos pueden prestarse dinero entre sí</p>
</div>

<div class="tabs">
    <button type="button" class="tab-btn active" data-tab="nuevo">Nuevo</button>
    <button type="button" class="tab-btn" data-tab="pendientes">Pendientes</button>
    <button type="button" class="tab-btn" data-tab="historial">Historial</button>
</div>

<!-- Nuevo préstamo -->
<div class="tab-panel active" id="panel-nuevo">
    <div class="card">
        <div class="field">
            <label for="prestamoOrigen">Área que presta</label>
            <select id="prestamoOrigen">
                <option value="Tienda">Tienda</option>
                <option value="Cocos">Cocos</option>
                <option value="Hielos">Hielos</option>
            </select>
        </div>
        <div class="field">
            <label for="prestamoDestino">Área que recibe</label>
            <select id="prestamoDestino">
                <option value="Cocos">Cocos</option>
                <option value="Tienda">Tienda</option>
                <option value="Hielos">Hielos</option>
            </select>
        </div>
        <div class="field">
            <label for="prestamoMonto">Cantidad</label>
            <input type="number" id="prestamoMonto" min="0.01" step="0.01" placeholder="0.00" />
        </div>
        <div class="field">
            <label for="prestamoDescripcion">Descripción (opcional)</label>
            <input type="text" id="prestamoDescripcion" placeholder="Ej. Compra de materia prima" />
        </div>
        <button type="button" class="btn btn-primary" id="btnCrearPrestamo">Registrar préstamo</button>
    </div>
</div>

<!-- Pendientes -->
<div class="tab-panel" id="panel-pendientes">
    <div class="card" id="prestamosPendientesLista">
        <div class="empty-state">No hay deudas pendientes.</div>
    </div>
</div>

<!-- Historial -->
<div class="tab-panel" id="panel-historial">
    <div class="card" id="prestamosHistorialLista">
        <div class="empty-state">Sin préstamos pagados todavía.</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/prestamos.js" asp-append-version="true"></script>
}
